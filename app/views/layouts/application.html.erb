<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "School Homework Marking System" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  </head>

  <body>
    <header class="navbar">
      <div class="nav-container">
        <a href="/" class="brand-logo">EduMark System</a>
        <nav class="nav-links">
          <a href="/" class="nav-link">Dashboard</a>
          <a href="/schools" class="nav-link">Schools</a>
          <a href="/students" class="nav-link">Students</a>
          <a href="/homeworks" class="nav-link">Homeworks</a>
          <a href="/markings" class="nav-link">Markings</a>
        </nav>
      </div>
    </header>

    <main class="page-container">
      <% if notice.present? %>
        <div class="alert alert-notice" role="status"><%= notice %></div>
      <% end %>
      <% if alert.present? %>
        <div class="alert alert-danger" role="alert"><%= alert %></div>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
