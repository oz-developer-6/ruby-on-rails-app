<%= form_with(model: school, local: true, html: { novalidate: true }) do |form| %>
  <% if school.errors.any? %>
    <div class="form-errors">
      <div class="form-errors-title">Please correct the following errors:</div>
      <ul class="form-errors-list">
        <% school.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= form.label :name, class: "form-label" %>
    <%= form.text_field :name, id: "school_name", class: "form-control", required: true %>
  </div>

  <div class="form-group">
    <%= form.label :code, class: "form-label" %>
    <%= form.text_field :code, id: "school_code", class: "form-control", required: true %>
  </div>

  <div class="form-group">
    <%= form.label :address, class: "form-label" %>
    <%= form.text_field :address, id: "school_address", class: "form-control" %>
  </div>

  <div class="action-buttons">
    <%= form.submit class: "btn btn-primary" %>
    <a href="/schools" class="btn btn-secondary">Cancel</a>
  </div>
<% end %>
